rules_version = '2';

// Mỗi người học chỉ đọc/ghi document tiến độ của chính mình: users/{uid}.
// Không có collection nào khác; mọi đường dẫn khác bị chặn mặc định.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'progress', 'updatedAt'])
        && request.resource.data.version is int
        && request.resource.data.progress is map
        && request.resource.data.updatedAt == request.time;
    }
  }
}
